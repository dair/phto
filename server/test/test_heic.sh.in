#!/usr/bin/env bash
# server/test/test_heic.sh.in — fix step fx2 / F1 + F2 end-to-end
#
#   - PUT /items with a truncated HEIC (several cut points) → 400 BrokenFile, nothing stored
#   - PUT /items with the valid HEIC → 201 {id = sha256, duplicate:false}
#   - PUT /items with the same valid HEIC again → 200 {same id, duplicate:true}
#   - truncated HEIC after a valid one is still rejected (no false "duplicate")
# Registered as "server_heic_test". Configured by CMake configure_file(@ONLY). Ports 19680–19699.

set -uo pipefail

IMAGERD_BIN="@IMAGERD_BIN@"
IMAGERADMIN_BIN="@IMAGERADMIN_BIN@"
HEIC_FIXTURE="@HEIC_FIXTURE@"

PASS=0
FAIL=0
check() {
  local name="$1"; shift
  local rc=0
  ( set -euo pipefail; "$@" ) || rc=$?
  if [ "$rc" -eq 0 ]; then echo "PASS: $name"; PASS=$((PASS + 1))
  else echo "FAIL: $name"; FAIL=$((FAIL + 1)); fi
}

for tool in curl python3 sha256sum; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "SKIP: $tool not found — server_heic_test skipped"
    exit 0
  fi
done
if [ ! -f "$HEIC_FIXTURE" ]; then echo "FATAL: fixture $HEIC_FIXTURE missing"; exit 1; fi

PORT=19680
T=$(mktemp -d)
STORAGE_ROOT="$T/storage"; mkdir -p "$STORAGE_ROOT"
CFG="$T/test.toml"
cat > "$CFG" <<CFGEOF
[[targets]]
root = "$STORAGE_ROOT"
database = "$T/imager.db"

[server]
bind = "127.0.0.1"
port = $PORT
threads = 2
max_upload_mb = 16

[auth]
database = "$T/auth.db"
jwt_secret = "this-is-a-32-byte-test-secret-ok"
issuer = "phto-test"
token_ttl_seconds = 3600
CFGEOF

printf '%s' "alicepass1" | "$IMAGERADMIN_BIN" "$CFG" user add alice "Alice User" --password-stdin || {
  echo "FATAL: seeding user failed"; rm -rf "$T"; exit 1; }

"$IMAGERD_BIN" "$CFG" >"$T/daemon.stdout" 2>"$T/daemon.stderr" &
DAEMON_PID=$!
cleanup() {
  if [ "${DAEMON_PID:-0}" -gt 0 ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
    kill -KILL "$DAEMON_PID" 2>/dev/null || true
    wait "$DAEMON_PID" 2>/dev/null || true
  fi
  rm -rf "$T"
}
trap cleanup EXIT

BASE_URL="http://127.0.0.1:${PORT}"
READY=$(curl --silent --output /dev/null --write-out "%{http_code}" --retry 10 \
  --retry-delay 1 --retry-connrefused --max-time 12 "$BASE_URL/health" 2>/dev/null) || READY="000"
if [ "$READY" != "200" ]; then
  echo "FATAL: daemon not ready ($READY)"; cat "$T/daemon.stderr" || true; exit 1
fi

json_get() { python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(eval(sys.argv[2]))' "$1" "$2"; }
http() {
  local prefix="$1"; shift
  curl --silent --output "$prefix.body" --write-out "%{http_code}" "$@" > "$prefix.status" 2>/dev/null || echo 000 > "$prefix.status"
}

LOGIN=$(curl --silent --request POST --header "Content-Type: application/json" \
  --data '{"login":"alice","password":"alicepass1"}' "$BASE_URL/auth/login")
TOKEN=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["token"])' "$LOGIN" 2>/dev/null || true)
check "setup: login returns a token" test -n "$TOKEN"
AUTH="Authorization: Bearer $TOKEN"

SIZE=$(stat -c %s "$HEIC_FIXTURE")
EXPECTED_ID=$(sha256sum "$HEIC_FIXTURE" | cut -d' ' -f1)
nfiles() { find "$STORAGE_ROOT" -type f | wc -l; }

# ---- truncated HEIC → 400 BrokenFile (F1) ---------------------------------
for cut in 1 16 1024 $((SIZE / 4)) $((SIZE / 2)) $((SIZE * 3 / 4)); do
  keep=$((SIZE - cut))
  head -c "$keep" "$HEIC_FIXTURE" > "$T/trunc-$cut.heic"
  http "$T/tr$cut" -X PUT -H "$AUTH" -H "X-Filename: trunc.heic" --data-binary "@$T/trunc-$cut.heic" "$BASE_URL/items"
  check "truncated HEIC (-$cut bytes) → 400" test "$(cat $T/tr$cut.status)" = 400
  check "truncated HEIC (-$cut bytes): error.code is BrokenFile" test "$(json_get $T/tr$cut.body "d['error']['code']")" = BrokenFile
done
check "truncated uploads store nothing" test "$(nfiles)" = 0

# ---- valid HEIC → 201, duplicate → 200 same id (F1 guard + F2) -------------
http "$T/new" -X PUT -H "$AUTH" -H "X-Filename: photo.heic" --data-binary "@$HEIC_FIXTURE" "$BASE_URL/items"
check "valid HEIC → 201" test "$(cat $T/new.status)" = 201
check "valid HEIC: duplicate false" test "$(json_get $T/new.body "d['duplicate']")" = False
check "valid HEIC: id is sha256" test "$(json_get $T/new.body "d['id']")" = "$EXPECTED_ID"

http "$T/dup" -X PUT -H "$AUTH" -H "X-Filename: again.heic" --data-binary "@$HEIC_FIXTURE" "$BASE_URL/items"
check "duplicate HEIC → 200" test "$(cat $T/dup.status)" = 200
check "duplicate HEIC: duplicate true" test "$(json_get $T/dup.body "d['duplicate']")" = True
check "duplicate HEIC: id is the existing 64-hex id" test "$(json_get $T/dup.body "d['id']")" = "$EXPECTED_ID"
check "duplicate HEIC: id has 64 chars" test "$(json_get $T/dup.body "len(d['id'])")" = 64

head -c $((SIZE - 1)) "$HEIC_FIXTURE" > "$T/after.heic"
http "$T/after" -X PUT -H "$AUTH" -H "X-Filename: after.heic" --data-binary "@$T/after.heic" "$BASE_URL/items"
check "truncated HEIC after valid upload still → 400" test "$(cat $T/after.status)" = 400
check "exactly one stored file" test "$(nfiles)" = 1

echo "----"
echo "passed=$PASS failed=$FAIL"
[ "$FAIL" -eq 0 ]
