# Help tools that honor '.gitignore' (redundant for Git itself).
/.git

/CMakeUserPresets.json

# Common build directories
build*/

# CI jobs that run in symlinked trees produce these artifacts.
/real_work/
/work

# MacOS Finder files.
.DS_Store

# Python compile output.
*.pyc

# See Utilities/Sphinx/tutorial_archive.cmake
/Help/_generated

# CLion work directory
/.idea/
# CLion build directories
/cmake-build-*/

# QtCreator files.
/CMakeLists.txt.user*

# Visual Studio Code
/.vscode/
/.cache/

# Visual Studio work directory
/.vs/
# Visual Studio build directory
/out/

# clang-tidy output
/clang-tidy-fixes.patch
# vim older versions
*~

resume.sh

/build

# Claude Code tooling lives at the workspace root (../.claude), never in this
# shareable repo. A local symlink (.claude -> ../.claude) redirects any agent
# that resolves .claude from here to the single workspace store; ignore it (and
# any stray .claude/) so it can never be committed.
/.claude
